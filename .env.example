# Connexion PostgreSQL utilisée par l'application (rôle aux droits restreints).
DATABASE_URL=postgres://amklabo_app:CHANGE_ME@localhost:5432/amklabo
# Connexion propriétaire utilisée UNIQUEMENT pour les migrations (jamais par l'application).
DATABASE_OWNER_URL=postgres://amklabo_owner:CHANGE_ME@localhost:5432/amklabo
# Mot de passe du rôle applicatif, appliqué par les migrations.
APP_DB_PASSWORD=CHANGE_ME
# Répertoire de stockage des fichiers envoyés (images produits, logo).
UPLOAD_DIR=./storage/uploads
# URL publique du site (utilisée pour les cookies sécurisés et les liens).
APP_URL=http://localhost:3000
